@startuml UC2_Liste_Produits_NoActor
!theme plain
skinparam backgroundColor #FAFAFA
skinparam activityBackgroundColor #E8F4FD
skinparam activityBorderColor #2980B9
skinparam activityDiamondBackgroundColor #FEF9E7
skinparam activityDiamondBorderColor #F39C12
skinparam arrowColor #2C3E50
skinparam activityStartColor #27AE60
skinparam activityEndColor #E74C3C
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12

title UC2 — Lister les Produits (Sans Acteur)

start
:Message reçu par le webhook WhatsApp
**"Liste mes produits"**;

:Debounce 1.5s;

:Vérifie la session active et l'identité;

if (Utilisateur authentifié ?) then (Non)
  :Répond "Numéro non associé à un compte";
  stop
else (Oui)
endif

:LLM identifie l'intention
→ Appelle **get_store_products()**;

:Requête GET /api/tools/stores/{id}/products;

if (API disponible ?) then (Erreur)
  :Retourne un message d'erreur technique;
  stop
else (OK)
  :Retourne la liste des produits;
endif

if (Nombre de produits > 5 ?) then (Oui)
  :Formate les 5 premiers produits;
  :Ajoute un bouton / mot-clé interactive **"Voir plus"**;
else (Non)
  :Formate l'intégralité des produits;
endif

:Appelle **final_answer()**;

:Sauvegarde l'historique de conversation;

:Ajoute le **menu des capacités**;

stop
@enduml
